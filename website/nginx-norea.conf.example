# NoREA (norea.rubinny.net) — nginx config for the static site.
# Use this if your server is nginx-only (then .htaccess is ignored).
#
# HestiaCP note: SSL, `listen`, and the `server_name`/`root` are already set by
# HestiaCP's templates. Do NOT paste a second `server { }` block — instead add
# just the "add_header" lines and the `location` blocks below into your domain's
# custom nginx config (Web domain → Edit → "nginx custom config"), or into the
# per-domain include at:
#   /home/<user>/conf/web/norea.rubinny.net/nginx.conf_*
# The full server blocks are shown for non-HestiaCP / manual setups.

# ---------- HestiaCP: paste ONLY this part into the existing HTTPS server ----------
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" always;
server_tokens off;

gzip on;
gzip_vary on;
gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

location ~* \.(?:css|js|png|jpe?g|svg|webp|woff2)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
}
location = /index.html {
    add_header Cache-Control "no-cache";
}
# Deny dotfiles (.htaccess, .git, …) but allow ACME challenges.
location ~ /\.(?!well-known) {
    deny all;
}
location / {
    try_files $uri $uri/ =404;
}
# Localized "page not found" page (absolute asset paths, works at any depth).
error_page 404 /404.html;
# RFC 9116 security contact.
location = /.well-known/security.txt {
    default_type "text/plain; charset=utf-8";
}

# ===================================================================================
# ---------- Full example for a MANUAL (non-HestiaCP) nginx setup -------------------
# Uncomment and adjust paths/cert lines if you manage nginx yourself.
#
# server {
#     listen 80;
#     listen [::]:80;
#     server_name norea.rubinny.net;
#     return 301 https://$host$request_uri;
# }
#
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name norea.rubinny.net;
#     root /var/www/norea.rubinny.net;   # folder with index.html
#     index index.html;
#
#     ssl_certificate     /etc/letsencrypt/live/norea.rubinny.net/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/norea.rubinny.net/privkey.pem;
#     ssl_protocols TLSv1.2 TLSv1.3;
#
#     # ... paste the add_header / gzip / location blocks from above here ...
# }
