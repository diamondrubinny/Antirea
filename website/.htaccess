# NoREA (norea.rubinny.net) — Apache config for a static site.
# Works on Apache (incl. HestiaCP's apache2 backend). If your server is
# nginx-only, this file is ignored — ask for the nginx equivalent instead.

# ---- Force HTTPS -----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Redirect any HTTP request to HTTPS (handles HestiaCP's proxied setup too).
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- Security headers ------------------------------------------------------
<IfModule mod_headers.c>
  # HSTS — only sent over HTTPS. Add "preload" and submit to hstspreload.org
  # ONLY when you are sure every subdomain will always be HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Content Security Policy. Scripts and styles are strict 'self': no inline
  # <script>, no inline style="" attributes anywhere on the site.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"

  # Do not leak the tech stack.
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# ---- Hardening -------------------------------------------------------------
# Localized "page not found" page (absolute asset paths, so it works at any depth).
ErrorDocument 404 /404.html

# RFC 9116 security contact.
<Files "security.txt">
  ForceType "text/plain; charset=utf-8"
</Files>

Options -Indexes
ServerSignature Off
AddDefaultCharset utf-8

# Block access to dotfiles (e.g. this .htaccess, .git).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ---- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---- Caching ---------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Long cache for fingerprintable static assets.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML should revalidate so content updates are picked up.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
