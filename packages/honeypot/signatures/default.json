    "runtimeFetchUa": "^(?:node|undici)(?:\\/[\\w.-]+)?$|^(?:Bun|Deno)\\/\\d",
    "automationUa": "playwright|puppeteer|webdriver|selenium|headless",
    "sourceMapAccept": "application\\/source-map\\+json",
