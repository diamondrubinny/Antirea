{
  "name": "@antirea/collector",
  "version": "0.1.0",
  "description": "Telemetry collector + intelligence dashboard for antirea",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "test": "node test/auth.mjs && node test/validate.mjs && node test/alerts.mjs",
    "test:http": "node test/http.mjs"
  },
  "dependencies": {
    "@antirea/adaptive": "*",
    "@antirea/watermark": "*",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.3",
    "geoip-lite": "^2.0.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": ">=0.40.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "author": "Diamond Rubinny",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diamondrubinny/Antirea.git",
    "directory": "packages/collector"
  },
  "homepage": "https://norea.rubinny.net",
  "bugs": {
    "url": "https://github.com/diamondrubinny/Antirea/issues"
  },
  "keywords": [
    "antirea",
    "norea",
    "anti-reverse-engineering",
    "code-protection",
    "rea",
    "telemetry",
    "dashboard",
    "security-monitoring",
    "geoip"
  ]
}
