# antirea collector configuration. Copy to .env and fill real values.
# NEVER commit the real .env.

# HTTP port
PORT=8080

# SQLite database file path
DB_FILE=./antirea.db

# REQUIRED. Random secret salt for hashing IPs (privacy). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_SALT=

# REQUIRED. Bearer token protecting the dashboard + admin APIs. Generate like IP_SALT.
ADMIN_TOKEN=

# Set true only if behind a trusted reverse proxy (to read X-Forwarded-For).
TRUST_PROXY=false

# Comma-separated allowed origins for the ingest endpoint, or * for any.
# For production, list your real site origins, e.g. https://app.example.com
ALLOWED_ORIGINS=*

# Data retention in days (auto-prune). Confirm against your privacy policy.
RETENTION_DAYS=90

# --- Adaptive AI advisor (optional) ---
# Heuristic analysis always runs. The AI advisor is OFF unless AI_ENABLED=true.
AI_ENABLED=false
# Auto-apply AI/heuristic proposals WITHOUT human approval. OFF by default.
# Even when true, only small threshold steps auto-apply; mode/blocks never do.
AI_AUTO_APPLY=false
# Model for the advisor (BYO key). Default: claude-opus-5-5.
AI_MODEL=claude-opus-5-5
# Run scheduled analysis every N minutes (0 = only on-demand from the panel).
AI_ANALYZE_INTERVAL_MIN=0
# Anthropic API key for the advisor. Only aggregated, non-PII summaries are sent.
# ANTHROPIC_API_KEY=sk-ant-...
