# antirea collector configuration. Copy to .env and fill real values.
# NEVER commit the real .env.

# HTTP port
PORT=8080

# SQLite database file path
DB_FILE=./antirea.db

# REQUIRED. Random secret salt for hashing IPs (privacy). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_SALT=

# REQUIRED. Bearer token protecting the dashboard + admin APIs. Generate like IP_SALT.
ADMIN_TOKEN=

# Number of trusted reverse proxies in front of the collector (reads X-Forwarded-For).
# false/0 = none (default). true = 1 (e.g. nginx, a load balancer). Use 2 for
# CDN + nginx. Only the entry that many hops from the right is trusted; values
# further left are client-supplied and ignored, so IPs cannot be forged.
TRUST_PROXY=false

# Comma-separated allowed origins for the ingest endpoint, or * for any.
# For production, list your real site origins, e.g. https://app.example.com
ALLOWED_ORIGINS=*

# Data retention in days (auto-prune). Confirm against your privacy policy.
RETENTION_DAYS=90

# --- Adaptive AI advisor (optional) ---
# Heuristic analysis always runs. The AI advisor is OFF unless AI_ENABLED=true.
AI_ENABLED=false
# Auto-apply AI/heuristic proposals WITHOUT human approval. OFF by default.
# Even when true, only small threshold steps auto-apply; mode/blocks never do.
AI_AUTO_APPLY=false
# Model for the advisor (BYO key). Default: claude-opus-5-5.
AI_MODEL=claude-opus-5-5
# Run scheduled analysis every N minutes (0 = only on-demand from the panel).
AI_ANALYZE_INTERVAL_MIN=0
# Anthropic API key for the advisor. Only aggregated, non-PII summaries are sent.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Attack-spike alerts (optional) ---
# Webhook (Slack/Discord/generic JSON) to notify on detection spikes. Empty = off.
ALERT_WEBHOOK_URL=
# Window (minutes) and event count that trigger an alert. The Alerter has its own
# cooldown so one incident won't spam the channel.
ALERT_WINDOW_MIN=5
ALERT_THRESHOLD=50
# Optional shared secret (16+ characters). Alerts are then signed:
#   X-Antirea-Timestamp: <unix seconds>
#   X-Antirea-Signature: sha256=<HMAC-SHA-256 of "<timestamp>.<body>">
ALERT_WEBHOOK_SECRET=
# Alert when a source-map canary is read (default true when a webhook is set).
ALERT_ON_CANARY=true
# Extra alert rules: comma-separated signal names; a trailing * is a prefix.
# Example: ALERT_SIGNALS=rea.*,honeypot:rea.*,cdp.debuggerPause
ALERT_SIGNALS=
# Only signals with at least this confidence (0..1) match ALERT_SIGNALS.
ALERT_MIN_CONFIDENCE=0
# Most alerts sent, in total, per 10-minute window (default 20). Further
# alerts are dropped and counted in the next alert's "suppressed" field.
ALERT_MAX_PER_WINDOW=20
