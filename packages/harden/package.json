{
  "name": "@antirea/harden",
  "version": "0.1.0",
  "description": "Client-code hardening: SRI/CSP/security headers, obfuscation preset, encrypted-bundle delivery",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js" }
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node test/harden.mjs"
  },
  "peerDependencies": {
    "express": "^4.21.0",
    "javascript-obfuscator": ">=4"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "javascript-obfuscator": { "optional": true }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  },
  "author": "Diamond Rubinny",
  "license": "Apache-2.0"
}
