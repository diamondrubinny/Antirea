{
  "name": "@antirea/challenge",
  "version": "0.1.0",
  "description": "Proof-of-work gating to make high-volume scraping expensive",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node test/pow.mjs",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "peerDependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  },
  "author": "Diamond Rubinny",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diamondrubinny/Antirea.git",
    "directory": "packages/challenge"
  },
  "homepage": "https://norea.rubinny.net",
  "bugs": {
    "url": "https://github.com/diamondrubinny/Antirea/issues"
  },
  "keywords": [
    "antirea",
    "norea",
    "anti-reverse-engineering",
    "code-protection",
    "rea",
    "proof-of-work",
    "anti-bot",
    "anti-scraping",
